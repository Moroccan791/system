{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "motion timeline",
  "type": "object",
  "required": ["version", "fps", "width", "height", "duration", "brand", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "fps": { "const": 30 },
    "width": { "const": 1080 },
    "height": { "const": 1920 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "brand": {
      "type": "object",
      "required": ["accent"],
      "additionalProperties": false,
      "properties": {
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "ink": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "paper": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "name": { "type": "string", "maxLength": 40 },
        "handle": { "type": "string", "maxLength": 40 }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "radius": { "enum": ["sharp", "round", "pill"] },
        "glow": { "type": "number", "minimum": 0, "maximum": 2 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "easing": { "enum": ["pop", "snap", "soft"] },
        "fontMode": { "enum": ["sans", "serif"] },
        "fontPack": { "enum": ["montserrat", "anton", "bebas", "grotesk", "serif", "archivo", "poppins", "luckiest"] },
        "captionShade": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "captionStyle": { "enum": ["pop", "karaoke", "stretch", "wiggle", "glide", "bounce", "neon", "marker"] }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" } }
  },
  "definitions": {
    "word": {
      "type": "object",
      "required": ["w", "at"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "string", "minLength": 1 },
        "at": { "type": "number", "minimum": 0 },
        "kind": { "enum": ["conn", "key", "serif", "word", "neon", "hero", "mark", "pay", "grad"] },
        "size": { "type": "number", "minimum": 58, "maximum": 320 },
        "glow": { "type": "boolean" },
        "emoji": { "type": "string", "maxLength": 24 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "phrase": {
      "type": "object",
      "required": ["text", "at"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 90 },
        "at": { "type": "number", "minimum": 0 },
        "hot": { "type": "boolean" }
      }
    },
    "plate": {
      "type": "object",
      "required": ["text", "at"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sub": { "type": "string" },
        "at": { "type": "number", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "required": ["type", "at"],
      "properties": {
        "type": { "enum": ["poster", "chip", "card", "fx", "pip", "broll", "counter", "list", "process", "vector", "lowerthird", "hook", "endcard", "proof", "phone", "doodle"] },
        "at": { "type": "number", "minimum": 0 },
        "until": { "type": "number", "exclusiveMinimum": 0 },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/word" } }
        },
        "captionStyle": { "enum": ["pop", "karaoke", "stretch", "wiggle", "glide", "bounce", "neon", "marker"] },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent2": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "gradient": { "type": "array", "minItems": 2, "maxItems": 2,
                      "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "heroSize": { "type": "number", "minimum": 150, "maximum": 340 },
        "behind": { "type": "boolean" },
        "place3d": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "y": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
            "rotY": { "type": "number", "minimum": -40, "maximum": 40 },
            "rotX": { "type": "number", "minimum": -30, "maximum": 30 },
            "persp": { "type": "number", "minimum": 500, "maximum": 1600 },
            "zoom": { "type": "array", "minItems": 2, "maxItems": 2,
                      "items": { "type": "number", "minimum": 0.5, "maximum": 1.6 } }
          }
        },
        "connSize": { "type": "number", "minimum": 58, "maximum": 90 },
        "keySize": { "type": "number", "minimum": 115, "maximum": 154 },
        "zone": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "number", "minimum": 0.3, "maximum": 0.95 }
        },
        "title": { "type": "string" },
        "sub": { "type": "string" },
        "titleSize": { "type": "number", "minimum": 58, "maximum": 90 },
        "subSize": { "type": "number", "minimum": 58, "maximum": 80 },
        "iconSvg": { "type": "string" },
        "bg": { "enum": ["dark", "accent", "white"] },
        "bgColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "lines": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/word" } }
        },
        "wordSize": { "type": "number", "minimum": 58, "maximum": 220 },
        "kind": { "enum": ["flash", "flare", "leak", "opening", "bwflash", "punch", "freeze"] },
        "zoom": { "type": "number", "minimum": 1.01, "maximum": 1.10 },
        "hookLines": { "type": "array", "minItems": 1, "maxItems": 3,
                       "items": { "type": "string", "minLength": 1, "maxLength": 26 } },
        "name": { "type": "string" },
        "mode": { "enum": ["fullbleed", "card"] },
        "dur": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "src": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "illustrative": { "type": "boolean" },
        "w": { "type": "number", "minimum": 0.55, "maximum": 0.70 },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "prefix": { "type": "string", "maxLength": 3 },
        "suffix": { "type": "string", "maxLength": 4 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 2 },
        "countDur": { "type": "number", "minimum": 0.8, "maximum": 1.0 },
        "items": { "type": "array", "minItems": 2, "maxItems": 6,
                   "items": { "$ref": "#/definitions/plate" } },
        "steps": { "type": "array", "minItems": 2, "maxItems": 5,
                   "items": { "$ref": "#/definitions/plate" } },
        "values": { "type": "array", "minItems": 2, "maxItems": 7,
                    "items": { "type": "number", "minimum": 0 } },
        "points": { "type": "array", "minItems": 2, "maxItems": 8,
                    "items": { "type": "number", "minimum": 0, "maximum": 100 } },
        "labels": { "type": "array", "maxItems": 7,
                    "items": { "type": "string", "maxLength": 12 } },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cols": { "type": "integer", "minimum": 5, "maximum": 20 },
        "hot": { "type": "integer", "minimum": 0, "maximum": 6 },
        "unit": { "type": "string", "maxLength": 4 },
        "left": { "type": "object", "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": { "label": { "type": "string", "maxLength": 16 },
                                  "value": { "type": "number", "minimum": 0 } } },
        "right": { "type": "object", "additionalProperties": false,
                   "required": ["label", "value"],
                   "properties": { "label": { "type": "string", "maxLength": 16 },
                                   "value": { "type": "number", "minimum": 0 } } },
        "win": { "enum": ["left", "right"] },
        "parts": { "type": "array", "minItems": 2, "maxItems": 4,
                   "items": { "type": "number", "exclusiveMinimum": 0 } },
        "events": { "type": "array", "minItems": 2, "maxItems": 5,
                    "items": { "type": "object", "additionalProperties": false,
                               "required": ["label"],
                               "properties": {
                                 "x": { "type": "number", "minimum": 0, "maximum": 1 },
                                 "label": { "type": "string", "maxLength": 16 },
                                 "sub": { "type": "string", "maxLength": 16 } } } },
        "quoteLines": { "type": "array", "minItems": 1, "maxItems": 3,
                        "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
        "by": { "type": "string", "maxLength": 40 },
        "messages": { "type": "array", "minItems": 2, "maxItems": 6,
                      "items": { "type": "object", "additionalProperties": false,
                                 "required": ["text"],
                                 "properties": {
                                   "text": { "type": "string", "minLength": 1, "maxLength": 30 },
                                   "me": { "type": "boolean" },
                                   "at": { "type": "number", "minimum": 0 } } } },
        "place": { "type": "string", "minLength": 1, "maxLength": 24 },
        "entries": { "type": "array", "minItems": 2, "maxItems": 5,
                     "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
        "pros": { "type": "array", "minItems": 1, "maxItems": 4,
                  "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
        "cons": { "type": "array", "minItems": 1, "maxItems": 4,
                  "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
        "word": { "type": "string", "minLength": 1, "maxLength": 16 },
        "day": { "type": "integer", "minimum": 0, "maximum": 6 },
        "from": { "type": "number", "minimum": 0 },
        "to": { "type": "number", "minimum": 0 },
        "sweep": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "index": { "type": "integer", "minimum": 1, "maximum": 12 },
        "before": { "type": "string", "minLength": 1, "maxLength": 12 },
        "after": { "type": "string", "minLength": 1, "maxLength": 12 },
        "phrases": { "type": "array", "minItems": 1, "maxItems": 6,
                     "items": { "$ref": "#/definitions/phrase" } },
        "hotAt": { "type": "number", "minimum": 0 },
        "hotBox": { "type": "array", "minItems": 4, "maxItems": 4,
                    "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "scroll": { "type": "number", "minimum": 0, "maximum": 1 },
        "video": { "type": "boolean" },
        "valueLabel": { "type": "string", "maxLength": 40 },
        "flip": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "poster" } } },
          "then": { "required": ["rows", "until"] } },
        { "if": { "properties": { "type": { "const": "chip" } } },
          "then": { "required": ["title", "until"] } },
        { "if": { "properties": { "type": { "const": "card" } } },
          "then": { "required": ["lines", "until"] } },
        { "if": { "properties": { "type": { "const": "fx" } } },
          "then": { "required": ["kind"] } },
        { "if": { "properties": { "type": { "const": "pip" } } },
          "then": { "required": ["src", "until", "illustrative"] } },
        { "if": { "properties": { "type": { "const": "broll" } } },
          "then": { "required": ["src", "until", "illustrative"] } },
        { "if": { "properties": { "type": { "const": "counter" } } },
          "then": { "required": ["value", "until"] } },
        { "if": { "properties": { "type": { "const": "list" } } },
          "then": { "required": ["items", "until"] } },
        { "if": { "properties": { "type": { "const": "process" } } },
          "then": { "required": ["steps", "until"] } },
        { "if": { "properties": { "type": { "const": "lowerthird" } } },
          "then": { "required": ["title", "until"] } },
        { "if": { "properties": { "type": { "const": "hook" } } },
          "then": { "required": ["hookLines", "until"] } },
        { "if": { "properties": { "type": { "const": "endcard" } } },
          "then": { "required": ["title", "until"] } },
        { "if": { "properties": { "type": { "const": "proof" } } },
          "then": { "required": ["phrases", "until"] } },
        { "if": { "properties": { "type": { "const": "phone" } } },
          "then": { "required": ["src", "until"] } },
        { "if": { "properties": { "type": { "const": "doodle" } } },
          "then": { "required": ["until"] } }
      ]
    }
  }
}
